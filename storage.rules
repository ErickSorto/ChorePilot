rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isValidProofImage(userId) {
      return request.resource != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function isValidDiscoveryImage(userId) {
      return request.resource != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /households/{householdId}/images/chores/{choreId}/proofs/{userId}/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn() && isValidProofImage(userId);
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /households/{householdId}/images/discovery/{userId}/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn() && isValidDiscoveryImage(userId);
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == userId;
    }
  }
}
